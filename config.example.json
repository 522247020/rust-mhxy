// 梦幻西游抓鬼/鬼王任务坐标辅助（rust-mhxy）配置示例
//
// 复制成 config.json 放在程序（或 exe）目录下即可生效。
// 支持 // 行注释和 /* */ 块注释。
{
  // ---- 识图（OCR）----
  // "local" 用内置本地 PP-OCR；"remote" 走远端 PP-OCR 服务
  "ocr/mode": "local",
  // 识别间隔（秒），范围 1~60（仅自动模式使用）
  "ocr/interval_seconds": 5,
  // 识别触发方式："auto" 按间隔自动识别；"manual" 按快捷键手动触发一次
  "ocr/trigger": "auto",
  // 手动模式的快捷键，例如 F8、Ctrl+F8；Windows 下全局生效
  "ocr/hotkey": "F8",
  // 任务栏截图区域，格式「左,上,右,下」，相对游戏客户区的百分比（0~1）
  "ocr/task_region": "0.70,0.24,0.99,0.70",
  // 第二个截图区域
  "ocr/extra_task_region": "0.70,0.71,0.99,0.90",
  // 是否启用第二个截图区域
  "ocr/extra_region_enabled": false,
  // OCR 前的预处理，可叠加，按固定顺序执行：颜色提取 → 灰度 → 二值化 → 反色
  // "off" 关闭；可组合，如 "binary"、"gray,binary"、"color,binary"、"binary,invert"
  // 颜色提取输出黑字白底；二值化把文字判成白色时再加 "invert"
  "ocr/preprocess": "off",
  // 颜色提取时保留的文字颜色（十六进制），默认 234, 255, 101 即 #eaff65
  "ocr/preprocess_color": "#eaff65",
  // 颜色提取时的颜色容差（每通道 0~255）
  "ocr/preprocess_tolerance": 24,

  // ---- 远端 PP-OCR ----
  // 请求格式："multipart"（POST /ocr，表单字段 file）/"raw"（POST /ocr/raw，原始字节）
  "api/format": "multipart",
  // PP-OCR 服务根地址，会自动拼 /ocr 或 /ocr/raw
  "api/url": "http://192.168.3.207:8008",
  // Bearer Token，可留空
  "api/token": "",

  // ---- 任务 ----
  // 任务面板开关。抓鬼 / 鬼王 按任务名解析；通用任务不看任务类型，与它们互斥。
  "task/option/抓鬼": true,
  "task/option/鬼王": true,
  // 通用任务：只按「地图名 + 坐标」标注，坐标不一定在主区域里，勾选后会自动开启备用区域
  "task/option/通用": false,
  // 任务面板布局：false 上下等分，true 左右等分（只有一个任务时占满整个区域）
  "task/horizontal_layout": false,
  // 捉鬼高概率区域：在抓鬼任务卡片顶部勾选后，地图上叠加 50×50 的高概率格子
  "task/high_chance": false,
  // 鬼王的高概率区域开关（独立于抓鬼）
  "task/high_chance/鬼王": false,
  // 大字体模式：OCR 把多位坐标截断导致 y 轴抖动时开启；同一 x 下大数字权重 3、小数字权重 1
  "task/large_font_mode": false,

  // ---- 图色门控 ----
  // 用少量点位的颜色快速判断「当前有没有任务」：未命中（战斗 / 任务完成）就跳过 OCR。
  // 点位坐标是游戏客户区像素（和截图同一坐标系），可在「识别区域」窗口里点击图片取点取色。
  "color_gate/enabled": false,
  // 轮询间隔（毫秒）
  "color_gate/interval_ms": 300,
  // 多点逻辑："all" 全部命中才算有任务；"any" 任一命中即可
  "color_gate/mode": "all",
  // 新增点位的默认容差（每通道 0~255）
  "color_gate/tolerance": 12,
  "color_gate/points": [
    // { "x": 1234, "y": 567, "color": "#d4a017", "tolerance": 15, "radius": 1, "label": "任务图标" }
  ],

  // ---- 日志 ----
  // 日志常开："simple" 只记启动应用 / 任务开始 / 任务停止；"detailed" 额外记录 OCR 过程与错误
  "log/level": "simple",

  // ---- 自动更新 ----
  // 启动后自动检查更新（侧栏「版本与更新」里也可以手动检查）
  "update/enabled": true,
  // 更新清单地址，默认走自建站点（国内访问比 GitHub 快）
  "update/manifest_url": "https://xyq.mhwy.work/latest.json",

  // ---- 窗口 ----
  // 左侧设置栏是否展开
  "window/sidebar_expanded": true,
  // 界面主题："dark" 暗色 / "light" 亮色
  "window/theme": "dark",
  // 侧栏分组折叠状态：逗号分隔，可取值 window / trigger / ocr / task / ui / log
  "window/sidebar/folded": "",
  // 识别区域窗口里三个分组的折叠状态（true = 展开）
  "window/region/scope_open": true,
  "window/region/gate_open": true,
  "window/region/preprocess_open": true,
  // 窗口置顶
  "window/coordinate/on_top": false
}
